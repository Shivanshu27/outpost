# Pin the public npm registry for this project.
#
# Without this, npm inherits whatever registry the developer has configured
# globally — and a corporate mirror's URLs get baked into package-lock.json,
# which then leaks internal infrastructure and fails for everyone outside that
# network. That happened here: an earlier lockfile carried 288 references to a
# private Nexus mirror, and the Docker build hung for 8 minutes on ETIMEDOUT.
registry=https://registry.npmjs.org/
