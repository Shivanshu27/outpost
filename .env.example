# ==============================================================================
# Outpost Environment Variables Example
#
# Copy this file to `.env` or set these in your shell / deployment environment.
# Outpost loads settings with prefix `OUTPOST_` and nested delimiter `__`.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM / Scoring Provider Settings
# ------------------------------------------------------------------------------
# Options: none | gemini | openai_compatible | ollama | manual
OUTPOST_LLM__PROVIDER=none

# Your API key (required for gemini or openai_compatible)
# OUTPOST_LLM__API_KEY=AIzaSy...

# Model name (e.g. gemini-2.0-flash, gpt-4o-mini, llama3.2)
# OUTPOST_LLM__MODEL=gemini-2.0-flash

# Base URL (for openai_compatible or ollama)
# OUTPOST_LLM__BASE_URL=https://openrouter.ai/api/v1
# OUTPOST_LLM__BASE_URL=http://localhost:11434

# Scoring batch size and limits
OUTPOST_LLM__BATCH_SIZE=10
OUTPOST_LLM__MAX_JOBS_PER_RUN=200
OUTPOST_LLM__REQUESTS_PER_MINUTE=15
OUTPOST_LLM__TIMEOUT_SECONDS=120.0

# ------------------------------------------------------------------------------
# Filters (Stage 5)
# ------------------------------------------------------------------------------
OUTPOST_FILTERS__EXCLUDE_INELIGIBLE=true
OUTPOST_FILTERS__EXCLUDE_UNKNOWN_ELIGIBILITY=false
OUTPOST_FILTERS__MAX_AGE_DAYS=45
OUTPOST_FILTERS__REQUIRE_TECH_SIGNAL=true
# OUTPOST_FILTERS__MIN_HOURLY_RATE_USD=40

# ------------------------------------------------------------------------------
# Server / UI Settings
# ------------------------------------------------------------------------------
# Binds to loopback by default for privacy (no auth is required on localhost)
OUTPOST_UI_HOST=127.0.0.1
OUTPOST_UI_PORT=8420
OUTPOST_LOG_LEVEL=INFO
OUTPOST_VERBOSE=false
